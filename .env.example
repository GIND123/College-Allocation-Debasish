# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# SQLite database file. On a host, point this at a persistent disk.
DB_PATH=./data/rankround.db

# Password for /admin. Use a long random string in production.
ADMIN_PASSWORD=change-me

# ---- OTP sign-in -------------------------------------------------------
# mock     : no SMS is sent; the code is always MOCK_OTP (default 1234).
#            For development and the client demo ONLY.
# firebase : Firebase Authentication phone sign-in (Google). Real SMS.
AUTH_PROVIDER=mock
MOCK_OTP=1234

# Needed only when AUTH_PROVIDER=firebase. From Firebase console →
# Project settings → General → Your apps → Web app → SDK config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
